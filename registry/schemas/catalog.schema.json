{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bijepur12345678-sys/Universal-Agent-Skills/blob/main/registry/schemas/catalog.schema.json",
  "title": "Universal Agent Skills Catalogue",
  "type": "object",
  "required": ["schema_version", "generated_at", "entrypoint", "skills"],
  "properties": {
    "schema_version": {"const": 1},
    "generated_at": {"type": "string", "format": "date"},
    "entrypoint": {"type": "string", "minLength": 1},
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "domain", "path", "version", "status", "tags", "source_ids", "license", "entrypoint"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "name": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 20, "maxLength": 500},
          "domain": {"type": "string"},
          "path": {"type": "string", "minLength": 1},
          "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"},
          "status": {"enum": ["stable", "experimental", "legacy", "deprecated", "archived"]},
          "tags": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "source_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "license": {"type": "string", "minLength": 1},
          "entrypoint": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
